    "withNewline": "first line\nsecond line",
    "withTab": "column\tcolumn",
    "withCarriageReturn": "old mac\rstyle",
    "withBackspace": "oops\b",
    "withFormFeed": "page\fbreak",
    "withUnicode": "arrow \u2192 and box \u2500 and emoji \ud83c\udf19",
